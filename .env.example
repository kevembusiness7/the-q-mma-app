# Copy this file to .env.local and fill in your own Supabase project's
# values (Settings -> API in your Supabase dashboard).
# Never commit .env.local or paste real keys into chat, tickets, or code
# review -- .env.local is already ignored by git.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
